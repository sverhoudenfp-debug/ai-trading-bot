# ── Basis (verplicht) ─────────────────────────────────────────────────────
SUPABASE_URL=https://JOUWPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role-key (server-side only!)
PAPER_TOKEN=lang-willekeurig-geheim (openssl rand -hex 20)

# ── AI (optioneel: zonder key draait de regel-strategie als fallback) ────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_PROPOSALS_EXECUTE=on          # 'on' = AI-voorstellen worden (in paper!) uitgevoerd
AI_QUIET_INTERVAL_MIN=15          # rustige markt → AI scant max elke X min
AI_VOLATILITY_PCT=1.2            # volatiliteitsdrempel voor elke-minuut-scans

# ── BloFin DEMO (uitsluitend demo — PAPER_LIVE blijft 'blofin') ─────────
BLOFIN_API_KEY=
BLOFIN_SECRET_KEY=
BLOFIN_PASSPHRASE=
BLOFIN_DEMO_HOST=https://demo-trading-openapi.blofin.com
PAPER_LIVE=blofin

# ── FASE 1: risico-limieten (alle optioneel — defaults in lib/risk/config.ts)
# RISK_MIN_PCT=0.25
# RISK_MAX_PCT=1.0
# RISK_DEFAULT_PCT=0.5
# MAX_NOTIONAL_PCT=25            # max notioneel per nieuwe trade (% equity)
# MAX_TOTAL_EXPOSURE_PCT=50      # max totaal open (% equity)
# MAX_OPEN_POSITIONS=4
# FEE_PCT=0.25
# SLIPPAGE_PCT=0.05
# FEE_COVER_FACTOR=2.5           # TP ≥ 2,5× round-trip-kosten
# MIN_NET_RR=1.0                 # netto reward/risk na kosten ≥ 1,0
# MIN_HOLD_MIN=15                # normale posities minimaal 15 min
# COOLDOWN_MIN=10                # na een exit: 10 min geen nieuwe entry dat pair
# MAX_ENTRIES_PER_PAIR_PER_HOUR=2
# MAX_ENTRIES_PER_PAIR_PER_DAY=6
# MAX_ENTRIES_PER_HOUR=8
# MAX_ENTRIES_PER_DAY=20
# DAILY_LOSS_LIMIT_PCT=5         # −5% op de pot → halt tot morgen
# LOSS_VELOCITY_COUNT=3          # ≥3 verliezen binnen 60 min → 60 min pauze
# LOSS_VELOCITY_WINDOW_MIN=60
# LOSS_VELOCITY_PAUSE_MIN=60
# MAX_PROPOSALS_PER_RUN=2        # hard: max 2 AI-voorstellen per run
# AI_MAX_CALLS_PER_HOUR=30
# AI_MAX_CALLS_PER_DAY=240
# AI_MAX_COST_USD_PER_DAY=3.0
# NEWS_FAIL_CLOSED=true          # nieuws-status verlopen → geen entries
# NEWS_STALE_GRACE_MIN=10
# TRADING_TIMEZONE=Europe/Amsterdam
# LEARN_MIN_TRADES=10            # leer-laag: min. sample voor nieuw gewicht

# ── FASE 2: Research Engine (allemaal optioneel — defaults in lib/research/config.ts) ──
# Apart research-AI-budget (los van het trading-budget):
# RESEARCH_MAX_AI_CALLS_PER_RUN=2
# RESEARCH_MAX_AI_CALLS_PER_DAY=4
# RESEARCH_MAX_COST_USD_PER_DAY=1.0
# RESEARCH_MAX_TOKENS_PER_RUN=25000
# Dataset-diepte (zelfde Bitvavo-bron als de trading-engine):
# RESEARCH_15M_DAYS=180
# RESEARCH_1H_DAYS=180
# Sample-eisen:
# RESEARCH_MIN_TRADES_IS=30
# RESEARCH_MIN_TRADES_OOS=12
# Splits/evaluatie:
# RESEARCH_TRAIN_PCT=65
# RESEARCH_WF_SEGMENTS=4
# RESEARCH_MAX_HYPOTHESES=3
# RESEARCH_CANDIDATE_MIN_SCORE=60

# ── FASE 3: Strategy Evolution Engine (defaults in lib/evolution/config.ts) ──
# Validation gate:
# GATE_MIN_TRADES_IS=30
# GATE_MIN_TRADES_OOS=12
# GATE_MIN_OOS_EXPECTANCY_EUR=0.05
# GATE_MIN_OOS_NET_PNL_EUR=0
# GATE_MIN_PROFIT_FACTOR=1.05
# GATE_MAX_OOS_DRAWDOWN_PCT=15
# GATE_MIN_WF_CONSISTENCY_PCT=50
# GATE_MIN_ROBUSTNESS_PASS_RATIO=0.6
# GATE_MIN_SCORE=55
# GATE_MIN_FEE_SCENARIO_PASS=0.4
# GATE_MAX_SINGLE_COIN_SHARE=0.8
# Baseline-vergelijking (fee-aware):
# BASELINE_MAX_TRADE_MULTIPLIER=2.5
# BASELINE_MIN_NET_IMPROVEMENT_EUR=10
# Canary:
# MAX_CONCURRENT_CANARIES=1
# MAX_ACTIVE_PER_FAMILY=1
# CANARY_RISK_CAP_PCT=0.25
# CANARY_MAX_PAIRS=4
# CANARY_MAX_TRADES_PER_DAY=4
# Paper validation:
# PAPER_MIN_TRADES=15
# PAPER_MIN_OBSERVATION_HOURS=48
# PAPER_MIN_NET_PNL_EUR=-2
# PAPER_MIN_EXPECTANCY_EUR=-0.1
# PAPER_MIN_PROFIT_FACTOR=0.9
# Rollback:
# ROLLBACK_MAX_LOSS_EUR=-8
# ROLLBACK_MAX_LOSS_STREAK=4
# ROLLBACK_MAX_DRAWDOWN_PCT=15
# ROLLBACK_MAX_FEE_SHARE_PCT=60
# ROLLBACK_MAX_TRADES_PER_DAY=8
# ROLLBACK_ERROR_COUNT=3
# Drift:
# DRIFT_WARN_EXPECTANCY_FACTOR=0.5
# DRIFT_ROLLBACK_EXPECTANCY_NEG=-0.2
# DRIFT_WARN_DD_FACTOR=1.5
# Rollback-cooldown (uren):
# ROLLBACK_COOLDOWN_HOURS=24
# Mutaties per cycle:
# MAX_MUTATIONS_PER_CYCLE=3
# Regime-selectie:
# MIN_REGIME_TRADES=10
# Score-combinatie (research/paper/regime):
# WEIGHT_RESEARCH=0.45
# WEIGHT_PAPER=0.35
# WEIGHT_REGIME=0.20
